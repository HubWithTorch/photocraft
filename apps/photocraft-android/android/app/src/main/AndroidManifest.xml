<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Full-screen immersive app -->
    <application
        android:label="PhotoCraft"
        android:hasCode="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="ai.storyteller.photocraft.FileHelper"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="photocraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open image files from file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Open PSD/project files from file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/vnd.adobe.photoshop" />
                <data android:mimeType="application/x-photocraft" />
            </intent-filter>

            <!-- Share/SEND intent -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/vnd.adobe.photoshop" />
                <data android:mimeType="application/x-photocraft" />
            </intent-filter>
        </activity>
    </application>
</manifest>